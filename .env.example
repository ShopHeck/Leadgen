# =============================================================================
# CloserFlow AI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Domain: https://closer-flow.com
# Hosting: Vercel + Neon PostgreSQL
# =============================================================================

# --- Database (Neon) ---
# Get from: https://console.neon.tech → Your Project → Connection Details
# Use the "pooled" connection string for serverless (Vercel)
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Auth (NextAuth.js v5) ---
# Generate with: npx auth secret
AUTH_SECRET=your-long-random-secret
NEXTAUTH_URL=https://closer-flow.com
NEXT_PUBLIC_APP_URL=https://closer-flow.com

# --- AI (OpenAI) ---
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Messaging: SMS (Twilio) ---
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# --- Messaging: Email (Resend) ---
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=team@closer-flow.com

# --- Booking (Calendly) ---
# Get from: Calendly Developer Portal → Webhook Subscriptions
CALENDLY_WEBHOOK_SIGNING_KEY=...

# --- Billing (Stripe) ---
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_SCALE=price_...

# --- Rate Limiting (Upstash Redis) ---
# Get from: https://console.upstash.com → Your Database → REST API
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# --- Cron & Queue (Upstash QStash) ---
# Get from: https://console.upstash.com → QStash tab → Token
# QStash handles automation retries with precise delays (free: 500 msgs/day)
QSTASH_TOKEN=...

# Fallback cron security for Vercel daily cron
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# --- PostHog Analytics ---
# Get from: https://posthog.com → Project Settings → Project API Key
# Free tier: 1M events/month, session replays, feature flags
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side key (same as NEXT_PUBLIC_POSTHOG_KEY or a separate one)
POSTHOG_API_KEY=phc_...

# --- ChromaDB (Vector Search) ---
# Self-hosted: docker run -p 8000:8000 chromadb/chroma
# Or use Chroma Cloud: https://www.trychroma.com/
CHROMA_URL=http://localhost:8000
# Only needed for Chroma Cloud (not self-hosted)
# CHROMA_API_KEY=...

# --- Google Cloud Platform (Cloud Tasks) ---
# Get from: https://console.cloud.google.com → IAM → Service Accounts
# Enable: Cloud Tasks API
# Required role: Cloud Tasks Enqueuer
GCP_TASKS_ENABLED=false
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
# Option A: Paste the full service account JSON (for Vercel/serverless)
# GCP_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}
# Option B: Set path to credentials file (for local dev / Cloud Run)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Auth token for task handler endpoints (use CRON_SECRET if shared)
GCP_TASKS_AUTH_TOKEN=your-task-auth-token

# --- Error Monitoring (Sentry) — optional ---
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_AUTH_TOKEN=sntrys_...
